{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.onlooker.dev/schemas/payload/plugins-safety.json",
	"title": "Safety plugin payloads",
	"description": "Payload schemas for sentinel.*, tribunal.*, warden.*, and compass.* events.",
	"$defs": {
		"sentinel.blocked": {
			"type": "object",
			"additionalProperties": false,
			"required": ["command", "risk_level", "matched_pattern"],
			"properties": {
				"command": { "type": "string" },
				"risk_level": {
					"type": "string",
					"enum": ["critical", "high", "medium"]
				},
				"matched_pattern": { "type": "string" },
				"reason": { "type": "string" }
			}
		},
		"sentinel.allowed": {
			"type": "object",
			"additionalProperties": false,
			"required": ["command", "risk_level"],
			"properties": {
				"command": { "type": "string" },
				"risk_level": { "type": "string", "enum": ["low", "none"] },
				"review_required": { "type": "boolean" }
			}
		},
		"sentinel.reviewed": {
			"type": "object",
			"additionalProperties": false,
			"required": ["command", "decision"],
			"properties": {
				"command": { "type": "string" },
				"decision": { "type": "string", "enum": ["approved", "rejected"] },
				"review_duration_ms": { "type": "integer", "minimum": 0 }
			}
		},
		"tribunal.session.start": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id"],
			"properties": {
				"task_id": { "type": "string" },
				"judge_types": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"standard",
							"security",
							"maintainability",
							"adversarial",
							"domain",
							"meta"
						]
					}
				},
				"gate_policy": {
					"type": "string",
					"enum": ["strict", "majority", "unanimous", "meta_override"]
				},
				"score_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
				"max_iterations": { "type": "integer", "minimum": 1 },
				"actor_model_id": { "type": "string" },
				"judge_model_ids": {
					"type": "array",
					"items": { "type": "string" }
				},
				"meta_model_id": { "type": "string" }
			}
		},
		"tribunal.session.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "outcome"],
			"properties": {
				"task_id": { "type": "string" },
				"outcome": {
					"type": "string",
					"enum": ["accepted", "rejected", "exhausted_iterations", "aborted"]
				},
				"final_score": { "type": "number", "minimum": 0, "maximum": 1 },
				"iterations_used": { "type": "integer", "minimum": 0 },
				"total_cost_usd": { "type": "number", "minimum": 0 },
				"total_duration_ms": { "type": "integer", "minimum": 0 }
			}
		},
		"tribunal.iteration.start": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "iteration_id", "iteration_number"],
			"properties": {
				"task_id": { "type": "string" },
				"iteration_id": { "type": "string" },
				"iteration_number": { "type": "integer", "minimum": 0 },
				"trigger": {
					"type": "string",
					"enum": ["initial", "gate_blocked", "appeal"]
				}
			}
		},
		"tribunal.actor.start": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "iteration_id"],
			"properties": {
				"task_id": { "type": "string" },
				"iteration_id": { "type": "string" },
				"iteration_number": { "type": "integer", "minimum": 0 },
				"actor_model_id": { "type": "string" }
			}
		},
		"tribunal.actor.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "success"],
			"properties": {
				"task_id": { "type": "string" },
				"success": { "type": "boolean" },
				"duration_ms": { "type": "integer", "minimum": 0 },
				"skepticism_rounds": { "type": "integer", "minimum": 0 },
				"iteration_id": { "type": "string" },
				"iteration_number": { "type": "integer", "minimum": 0 },
				"artifact_kind": {
					"type": "string",
					"enum": ["file", "patch", "message", "command"]
				},
				"actor_model_id": { "type": "string" }
			}
		},
		"tribunal.judge.start": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "iteration_id", "judge_id", "judge_type"],
			"properties": {
				"task_id": { "type": "string" },
				"iteration_id": { "type": "string" },
				"judge_id": { "type": "string" },
				"judge_type": {
					"type": "string",
					"enum": [
						"standard",
						"security",
						"maintainability",
						"adversarial",
						"domain",
						"meta"
					]
				},
				"judge_model_id": { "type": "string" }
			}
		},
		"tribunal.verdict": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "score", "passed", "judge_type"],
			"properties": {
				"task_id": { "type": "string" },
				"score": { "type": "number", "minimum": 0, "maximum": 1 },
				"passed": { "type": "boolean" },
				"judge_type": {
					"type": "string",
					"enum": [
						"standard",
						"security",
						"maintainability",
						"adversarial",
						"domain",
						"meta"
					]
				},
				"feedback_summary": { "type": "string" },
				"file_path": { "type": "string" },
				"iteration_id": { "type": "string" },
				"judge_id": { "type": "string" },
				"judge_model_id": { "type": "string" },
				"criteria_evaluated": {
					"type": "array",
					"items": { "type": "string" }
				},
				"strengths_count": { "type": "integer", "minimum": 0 },
				"weaknesses_count": { "type": "integer", "minimum": 0 },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"tribunal.meta.start": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "iteration_id"],
			"properties": {
				"task_id": { "type": "string" },
				"iteration_id": { "type": "string" },
				"meta_model_id": { "type": "string" },
				"verdicts_reviewed": { "type": "integer", "minimum": 0 }
			}
		},
		"tribunal.meta.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "verdict_quality", "bias_detected"],
			"properties": {
				"task_id": { "type": "string" },
				"verdict_quality": {
					"type": "string",
					"enum": ["sound", "questionable", "biased"]
				},
				"bias_detected": { "type": "boolean" },
				"override_recommendation": {
					"type": "string",
					"enum": ["accept", "reject", "re-evaluate"]
				},
				"iteration_id": { "type": "string" },
				"bias_types": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"position",
							"verbosity",
							"self_enhancement",
							"sycophancy",
							"refusal",
							"length"
						]
					}
				},
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"meta_model_id": { "type": "string" }
			}
		},
		"tribunal.jury.empaneled": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "iteration_id", "judges"],
			"properties": {
				"task_id": { "type": "string" },
				"iteration_id": { "type": "string" },
				"judges": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["judge_id", "judge_type"],
						"properties": {
							"judge_id": { "type": "string" },
							"judge_type": {
								"type": "string",
								"enum": [
									"standard",
									"security",
									"maintainability",
									"adversarial",
									"domain",
									"meta"
								]
							},
							"model_id": { "type": "string" }
						}
					}
				},
				"panel_size": { "type": "integer", "minimum": 1 }
			}
		},
		"tribunal.consensus.reached": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"task_id",
				"iteration_id",
				"aggregated_score",
				"passed",
				"aggregation_method",
				"judges"
			],
			"properties": {
				"task_id": { "type": "string" },
				"iteration_id": { "type": "string" },
				"aggregated_score": { "type": "number", "minimum": 0, "maximum": 1 },
				"passed": { "type": "boolean" },
				"aggregation_method": {
					"type": "string",
					"enum": ["mean", "median", "min", "weighted_mean"]
				},
				"judges": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["judge_id", "score"],
						"properties": {
							"judge_id": { "type": "string" },
							"score": { "type": "number", "minimum": 0, "maximum": 1 }
						}
					}
				}
			}
		},
		"tribunal.dissent.recorded": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "iteration_id", "disagreement_score", "judges"],
			"properties": {
				"task_id": { "type": "string" },
				"iteration_id": { "type": "string" },
				"disagreement_score": { "type": "number", "minimum": 0, "maximum": 1 },
				"judges": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["judge_id", "score", "passed"],
						"properties": {
							"judge_id": { "type": "string" },
							"score": { "type": "number", "minimum": 0, "maximum": 1 },
							"passed": { "type": "boolean" }
						}
					}
				},
				"resolution": {
					"type": "string",
					"enum": ["meta_override", "majority", "re-evaluate", "escalate"]
				}
			}
		},
		"tribunal.gate.passed": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "iteration_id", "final_score"],
			"properties": {
				"task_id": { "type": "string" },
				"iteration_id": { "type": "string" },
				"final_score": { "type": "number", "minimum": 0, "maximum": 1 },
				"iteration_number": { "type": "integer", "minimum": 0 },
				"judges_consulted": { "type": "integer", "minimum": 1 }
			}
		},
		"tribunal.gate.blocked": {
			"type": "object",
			"additionalProperties": false,
			"required": ["task_id", "iteration_id", "reason"],
			"properties": {
				"task_id": { "type": "string" },
				"iteration_id": { "type": "string" },
				"reason": {
					"type": "string",
					"enum": [
						"low_score",
						"meta_override",
						"bias_detected",
						"dissent_unresolved"
					]
				},
				"final_score": { "type": "number", "minimum": 0, "maximum": 1 },
				"iteration_number": { "type": "integer", "minimum": 0 },
				"will_retry": { "type": "boolean" },
				"retry_iteration_number": { "type": "integer", "minimum": 0 }
			}
		},
		"warden.threat.detected": {
			"type": "object",
			"additionalProperties": false,
			"required": ["source_type", "threat_type", "confidence"],
			"properties": {
				"source_type": { "type": "string", "enum": ["web_fetch", "file_read"] },
				"threat_type": {
					"type": "string",
					"enum": [
						"prompt_injection",
						"instruction_override",
						"credential_exfiltration",
						"command_injection",
						"social_engineering"
					]
				},
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"source_url": { "type": "string" },
				"source_path": { "type": "string" },
				"snippet": { "type": "string" }
			}
		},
		"warden.threat.cleared": {
			"type": "object",
			"additionalProperties": false,
			"required": ["source_type"],
			"properties": {
				"source_type": { "type": "string", "enum": ["web_fetch", "file_read"] },
				"cleared_by": {
					"type": "string",
					"enum": ["timeout", "user_override", "subsequent_scan_clean"]
				}
			}
		},
		"warden.gate.blocked": {
			"type": "object",
			"additionalProperties": false,
			"required": ["blocked_operation", "threat_source_type"],
			"properties": {
				"blocked_operation": {
					"type": "string",
					"enum": ["tool.file.write", "tool.file.edit", "tool.shell.exec"]
				},
				"threat_source_type": {
					"type": "string",
					"enum": ["web_fetch", "file_read"]
				}
			}
		},
		"compass.check.passed": {
			"type": "object",
			"additionalProperties": false,
			"required": ["confidence", "stddev", "file_path", "tool_name"],
			"properties": {
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"stddev": { "type": "number", "minimum": 0 },
				"file_path": { "type": "string" },
				"tool_name": {
					"type": "string",
					"enum": ["Write", "Edit", "MultiEdit", "Bash"]
				},
				"had_prior_turn": { "type": "boolean" },
				"sample_count": { "type": "integer", "minimum": 0 }
			}
		},
		"compass.check.failed": {
			"type": "object",
			"additionalProperties": false,
			"required": ["confidence", "stddev", "file_path"],
			"properties": {
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"stddev": { "type": "number", "minimum": 0 },
				"file_path": { "type": "string" },
				"tool_name": {
					"type": "string",
					"enum": ["Write", "Edit", "MultiEdit", "Bash"]
				},
				"primary_concern": {
					"type": "string",
					"enum": ["scope", "target", "context", "destructive", "none"]
				},
				"had_prior_turn": { "type": "boolean" },
				"sample_count": { "type": "integer", "minimum": 0 }
			}
		},
		"compass.check.skipped": {
			"type": "object",
			"additionalProperties": false,
			"required": ["reason"],
			"properties": {
				"reason": {
					"type": "string",
					"enum": [
						"skip_sentinel",
						"skip_glob",
						"dir_plus_stem_cooldown",
						"turn_budget_exhausted",
						"insufficient_context",
						"reply_to_question_pattern",
						"sampler_error",
						"circuit_open",
						"evaluator_budget_exhausted"
					]
				},
				"file_path": { "type": "string" },
				"tool_name": {
					"type": "string",
					"enum": ["Write", "Edit", "MultiEdit", "Bash"]
				}
			}
		},
		"compass.check.overridden": {
			"type": "object",
			"additionalProperties": false,
			"required": ["file_path", "user_acknowledgment"],
			"properties": {
				"file_path": { "type": "string" },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"stddev": { "type": "number", "minimum": 0 },
				"user_acknowledgment": { "type": "boolean", "const": true }
			}
		},
		"compass.check.canceled": {
			"type": "object",
			"additionalProperties": false,
			"required": ["file_path"],
			"properties": {
				"file_path": { "type": "string" },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"stddev": { "type": "number", "minimum": 0 }
			}
		}
	}
}
