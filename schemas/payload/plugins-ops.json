{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.onlooker.dev/schemas/payload/plugins-ops.json",
	"title": "Ops plugin payloads",
	"description": "Payload schemas for governor.*, echo.*, counsel.*, onlooker.*, meridian.*, and assayer.* events.",
	"$defs": {
		"governor.gate.checked": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"session_id",
				"agent_id",
				"agent_type",
				"decision",
				"estimated_tokens",
				"tokens_available",
				"estimation_method",
				"safety_margin"
			],
			"properties": {
				"session_id": { "type": "string" },
				"agent_id": { "type": "string" },
				"agent_type": { "type": "string" },
				"decision": { "type": "string", "enum": ["allow", "block"] },
				"reason": {
					"type": "string",
					"enum": ["budget_exceeded", "ceiling_exceeded", "lock_timeout"]
				},
				"estimated_tokens": { "type": "integer", "minimum": 0 },
				"tokens_available": { "type": "integer", "minimum": 0 },
				"estimation_method": {
					"type": "string",
					"enum": ["tiktoken", "char_ratio", "tier_table"]
				},
				"safety_margin": { "type": "number", "minimum": 1 }
			}
		},
		"governor.call.recorded": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"session_id",
				"agent_id",
				"agent_type",
				"estimated_tokens",
				"cost_usd_estimated",
				"duration_ms"
			],
			"properties": {
				"session_id": { "type": "string" },
				"agent_id": { "type": "string" },
				"agent_type": { "type": "string" },
				"estimated_tokens": { "type": "integer", "minimum": 0 },
				"actual_tokens": { "type": "integer", "minimum": 0 },
				"estimation_error_pct": { "type": "number" },
				"cost_usd_estimated": { "type": "number", "minimum": 0 },
				"cost_usd_actual": { "type": "number", "minimum": 0 },
				"duration_ms": { "type": "integer", "minimum": 0 },
				"tokens_returned_to_pool": { "type": "integer" }
			},
			"dependentRequired": {
				"actual_tokens": ["tokens_returned_to_pool"],
				"estimation_error_pct": ["actual_tokens"],
				"cost_usd_actual": ["actual_tokens"]
			}
		},
		"governor.ledger.write_failed": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"session_id",
				"agent_id",
				"error",
				"retry_count",
				"ledger_poisoned",
				"unrecorded_tokens"
			],
			"properties": {
				"session_id": { "type": "string" },
				"agent_id": { "type": "string" },
				"error": { "type": "string" },
				"retry_count": { "type": "integer", "minimum": 0 },
				"ledger_poisoned": { "type": "boolean" },
				"unrecorded_tokens": { "type": "integer", "minimum": 0 }
			}
		},
		"governor.child.allocated": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"session_id",
				"parent_agent_id",
				"child_agent_id",
				"child_agent_type",
				"tokens_allocated",
				"cost_usd_allocated",
				"tokens_remaining_after_allocation",
				"conservation_check_passed"
			],
			"properties": {
				"session_id": { "type": "string" },
				"parent_agent_id": { "type": "string" },
				"child_agent_id": { "type": "string" },
				"child_agent_type": { "type": "string" },
				"tokens_allocated": { "type": "integer", "minimum": 0 },
				"cost_usd_allocated": { "type": "number", "minimum": 0 },
				"tokens_remaining_after_allocation": {
					"type": "integer",
					"minimum": 0
				},
				"conservation_check_passed": { "type": "boolean" }
			}
		},
		"governor.child.returned": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"session_id",
				"parent_agent_id",
				"child_agent_id",
				"tokens_allocated",
				"tokens_consumed",
				"tokens_returned"
			],
			"properties": {
				"session_id": { "type": "string" },
				"parent_agent_id": { "type": "string" },
				"child_agent_id": { "type": "string" },
				"tokens_allocated": { "type": "integer", "minimum": 0 },
				"tokens_consumed": { "type": "integer", "minimum": 0 },
				"tokens_returned": { "type": "integer", "minimum": 0 }
			}
		},
		"governor.budget.warning": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"budget_usd",
				"spent_usd",
				"threshold_pct",
				"session_id",
				"dimension"
			],
			"properties": {
				"budget_usd": { "type": "number", "minimum": 0 },
				"spent_usd": { "type": "number", "minimum": 0 },
				"threshold_pct": { "type": "number", "minimum": 0, "maximum": 100 },
				"remaining_usd": { "type": "number" },
				"session_id": { "type": "string" },
				"dimension": {
					"type": "string",
					"enum": ["cost_usd", "tokens", "api_calls", "wall_clock_seconds"]
				},
				"tokens_budget": { "type": "integer", "minimum": 0 },
				"tokens_spent": { "type": "integer", "minimum": 0 },
				"api_calls_budget": { "type": "integer", "minimum": 0 },
				"api_calls_spent": { "type": "integer", "minimum": 0 }
			}
		},
		"governor.budget.exceeded": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"budget_usd",
				"spent_usd",
				"blocked_operation",
				"session_id",
				"agent_id",
				"dimension",
				"estimated_call_cost",
				"ceiling_type"
			],
			"properties": {
				"budget_usd": { "type": "number", "minimum": 0 },
				"spent_usd": { "type": "number", "minimum": 0 },
				"blocked_operation": { "type": "string" },
				"session_id": { "type": "string" },
				"agent_id": { "type": "string" },
				"dimension": {
					"type": "string",
					"enum": ["cost_usd", "tokens", "api_calls", "wall_clock_seconds"]
				},
				"estimated_call_cost": { "type": "number", "minimum": 0 },
				"ceiling_type": {
					"type": "string",
					"enum": ["session", "global", "per_call"]
				}
			}
		},
		"governor.session.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"total_cost_usd",
				"budget_usd",
				"under_budget",
				"session_id",
				"total_tokens",
				"total_api_calls",
				"duration_ms",
				"calls_blocked",
				"calls_warned",
				"ledger_poisoned"
			],
			"properties": {
				"total_cost_usd": { "type": "number", "minimum": 0 },
				"budget_usd": { "type": "number", "minimum": 0 },
				"under_budget": { "type": "boolean" },
				"cost_by_plugin": {
					"type": "object",
					"additionalProperties": { "type": "number" }
				},
				"session_id": { "type": "string" },
				"total_tokens": { "type": "integer", "minimum": 0 },
				"total_api_calls": { "type": "integer", "minimum": 0 },
				"duration_ms": { "type": "integer", "minimum": 0 },
				"calls_blocked": { "type": "integer", "minimum": 0 },
				"calls_warned": { "type": "integer", "minimum": 0 },
				"ledger_poisoned": { "type": "boolean" },
				"estimation_accuracy_pct": { "type": "number" }
			}
		},
		"governor.lock.stale_cleared": {
			"type": "object",
			"additionalProperties": false,
			"required": ["lock_path", "lock_age_seconds", "pid_verified_dead"],
			"properties": {
				"lock_path": { "type": "string" },
				"lock_age_seconds": { "type": "number", "minimum": 0 },
				"pid_verified_dead": { "type": "boolean" }
			}
		},
		"bursar.session.recorded": {
			"type": "object",
			"additionalProperties": false,
			"required": ["project_key", "session_id", "governor_present"],
			"properties": {
				"project_key": { "type": "string" },
				"session_id": { "type": "string" },
				"governor_present": { "type": "boolean" },
				"cost_usd": { "type": "number", "minimum": 0 },
				"tokens": { "type": "integer", "minimum": 0 },
				"api_calls": { "type": "integer", "minimum": 0 },
				"model": { "type": "string" }
			}
		},
		"bursar.rollup.surfaced": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"project_key",
				"window",
				"total_cost_usd",
				"session_count",
				"total_tokens",
				"sessions_with_cost"
			],
			"properties": {
				"project_key": { "type": "string" },
				"window": {
					"type": "string",
					"enum": ["rolling_7d", "calendar_week"]
				},
				"total_cost_usd": { "type": "number", "minimum": 0 },
				"session_count": { "type": "integer", "minimum": 0 },
				"total_tokens": { "type": "integer", "minimum": 0 },
				"sessions_with_cost": { "type": "integer", "minimum": 0 },
				"window_start": { "type": "string", "format": "date-time" }
			}
		},
		"bursar.rollup.skipped": {
			"type": "object",
			"additionalProperties": false,
			"required": ["reason"],
			"properties": {
				"reason": {
					"type": "string",
					"enum": ["disabled", "no_data", "error"]
				},
				"project_key": { "type": "string" }
			}
		},
		"lineage.change.recorded": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"project_key",
				"session_id",
				"file_path",
				"tool",
				"operation"
			],
			"properties": {
				"project_key": { "type": "string" },
				"session_id": { "type": "string" },
				"file_path": { "type": "string" },
				"tool": {
					"type": "string",
					"enum": ["Edit", "Write", "MultiEdit"]
				},
				"operation": {
					"type": "string",
					"enum": ["create", "overwrite", "edit", "multi_edit"]
				},
				"change_id": { "type": "string" },
				"turn": { "type": "integer", "minimum": 0 },
				"tool_use_id": { "type": "string" },
				"agent_type": { "type": "string" },
				"lines_added": { "type": "integer", "minimum": 0 },
				"lines_removed": { "type": "integer", "minimum": 0 },
				"bytes": { "type": "integer", "minimum": 0 },
				"edit_count": { "type": "integer", "minimum": 0 },
				"content_sha256": { "type": "string" }
			}
		},
		"lineage.query.answered": {
			"type": "object",
			"additionalProperties": false,
			"required": ["project_key", "file_path", "matches"],
			"properties": {
				"project_key": { "type": "string" },
				"file_path": { "type": "string" },
				"matches": { "type": "integer", "minimum": 0 },
				"query": { "type": "string" },
				"line": { "type": "integer", "minimum": 0 },
				"resolved_via": {
					"type": "string",
					"enum": ["historian", "transcript", "none"]
				}
			}
		},
		"echo.suite.started": {
			"type": "object",
			"additionalProperties": false,
			"required": ["suite_id", "test_count"],
			"properties": {
				"suite_id": { "type": "string" },
				"test_count": { "type": "integer", "minimum": 0 },
				"suite_name": { "type": "string" },
				"trigger": {
					"type": "string",
					"enum": ["config_change", "manual", "file_change"]
				},
				"changed_file": { "type": "string" }
			}
		},
		"echo.suite.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["suite_id", "test_count", "improved", "degraded", "neutral"],
			"properties": {
				"suite_id": { "type": "string" },
				"test_count": { "type": "integer", "minimum": 0 },
				"improved": { "type": "integer", "minimum": 0 },
				"degraded": { "type": "integer", "minimum": 0 },
				"neutral": { "type": "integer", "minimum": 0 },
				"merge_recommended": { "type": "boolean" },
				"duration_ms": { "type": "integer", "minimum": 0 },
				"baseline_score": { "type": "number", "minimum": 0, "maximum": 1 },
				"score_after": { "type": "number", "minimum": 0, "maximum": 1 },
				"drift": { "type": "number", "minimum": -1, "maximum": 1 },
				"drift_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
			},
			"dependentRequired": {
				"drift": ["baseline_score", "score_after", "drift_threshold"],
				"baseline_score": ["score_after", "drift", "drift_threshold"],
				"score_after": ["baseline_score", "drift", "drift_threshold"],
				"drift_threshold": ["baseline_score", "score_after", "drift"]
			}
		},
		"echo.regression.detected": {
			"type": "object",
			"additionalProperties": false,
			"required": ["suite_id", "test_id", "score_before", "score_after"],
			"properties": {
				"suite_id": { "type": "string" },
				"test_id": { "type": "string" },
				"score_before": { "type": "number", "minimum": 0, "maximum": 1 },
				"score_after": { "type": "number", "minimum": 0, "maximum": 1 },
				"test_name": { "type": "string" },
				"delta": { "type": "number" },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"echo.improvement.detected": {
			"type": "object",
			"additionalProperties": false,
			"required": ["suite_id", "test_id", "score_before", "score_after"],
			"properties": {
				"suite_id": { "type": "string" },
				"test_id": { "type": "string" },
				"score_before": { "type": "number", "minimum": 0, "maximum": 1 },
				"score_after": { "type": "number", "minimum": 0, "maximum": 1 },
				"test_name": { "type": "string" },
				"delta": { "type": "number" },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"counsel.brief.generated": {
			"type": "object",
			"additionalProperties": false,
			"required": ["period_start", "period_end", "recommendation_count"],
			"properties": {
				"period_start": { "type": "string", "format": "date-time" },
				"period_end": { "type": "string", "format": "date-time" },
				"recommendation_count": { "type": "integer", "minimum": 0 },
				"sources_consulted": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"onlooker_events",
							"tribunal_verdicts",
							"echo_regressions",
							"sentinel_audit",
							"warden_audit",
							"oracle_calibrations",
							"meridian_reliance"
						]
					}
				}
			}
		},
		"onlooker.session.summary": {
			"type": "object",
			"additionalProperties": false,
			"required": ["session_id", "duration_ms", "event_count"],
			"properties": {
				"session_id": { "type": "string" },
				"duration_ms": { "type": "integer", "minimum": 0 },
				"event_count": { "type": "integer", "minimum": 0 },
				"tool_counts": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"file_reads": { "type": "integer", "minimum": 0 },
						"file_writes": { "type": "integer", "minimum": 0 },
						"file_edits": { "type": "integer", "minimum": 0 },
						"shell_execs": { "type": "integer", "minimum": 0 },
						"web_fetches": { "type": "integer", "minimum": 0 },
						"agent_spawns": { "type": "integer", "minimum": 0 }
					}
				}
			}
		},
		"meridian.hint.generated": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"hint_id",
				"case_id",
				"task_type",
				"failure_type",
				"hint_direction"
			],
			"properties": {
				"hint_id": { "type": "string" },
				"case_id": { "type": "string" },
				"task_type": {
					"type": "string",
					"enum": ["code", "reasoning", "writing", "general"]
				},
				"failure_type": {
					"type": "string",
					"enum": [
						"wrong_approach",
						"missing_concept",
						"implementation_error",
						"misunderstood_task",
						"out_of_scope"
					]
				},
				"hint_direction": {
					"type": "string",
					"enum": [
						"reframe",
						"missing_tool",
						"intermediate_goal",
						"alternative_representation",
						"constraint_reminder"
					]
				},
				"target_concept": { "type": "string" },
				"signal_creation": { "type": "number", "minimum": 0, "maximum": 1 },
				"signal_transfer": { "type": "number", "minimum": 0, "maximum": 1 },
				"playbook_bullets_injected": { "type": "integer", "minimum": 0 }
			}
		},
		"meridian.hint.delivered": {
			"type": "object",
			"additionalProperties": false,
			"required": ["hint_id", "case_id", "delivery_mode"],
			"properties": {
				"hint_id": { "type": "string" },
				"case_id": { "type": "string" },
				"delivery_mode": {
					"type": "string",
					"enum": ["append", "comment", "inline", "aside"]
				}
			}
		},
		"meridian.outcome.recorded": {
			"type": "object",
			"additionalProperties": false,
			"required": ["hint_id", "case_id", "succeeded", "attempts_after_hint"],
			"properties": {
				"hint_id": { "type": "string" },
				"case_id": { "type": "string" },
				"succeeded": { "type": "boolean" },
				"attempts_after_hint": { "type": "integer", "minimum": 0 },
				"hint_referenced": { "type": "boolean" },
				"time_to_success_ms": { "type": "integer", "minimum": 0 }
			}
		},
		"meridian.reliance.measured": {
			"type": "object",
			"additionalProperties": false,
			"required": ["hint_id", "case_id", "score", "assessment", "method"],
			"properties": {
				"hint_id": { "type": "string" },
				"case_id": { "type": "string" },
				"score": { "type": "number", "minimum": 0, "maximum": 1 },
				"assessment": { "type": "string", "enum": ["low", "medium", "high"] },
				"method": { "type": "string", "enum": ["logprob", "judge"] }
			}
		},
		"meridian.lesson.curated": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"bullet_id",
				"case_id",
				"category",
				"task_type",
				"target_concept"
			],
			"properties": {
				"bullet_id": { "type": "string" },
				"case_id": { "type": "string" },
				"category": {
					"type": "string",
					"enum": [
						"failure_pattern",
						"successful_hint",
						"task_strategy",
						"tool_usage"
					]
				},
				"task_type": {
					"type": "string",
					"enum": ["code", "reasoning", "writing", "general"]
				},
				"target_concept": { "type": "string" },
				"origin": {
					"type": "string",
					"enum": ["agent_failure", "human_session", "manual"]
				}
			}
		},
		"meridian.playbook.updated": {
			"type": "object",
			"additionalProperties": false,
			"required": ["scope_id", "operation", "bullet_count_after"],
			"properties": {
				"scope_id": { "type": "string" },
				"operation": {
					"type": "string",
					"enum": ["append", "update", "deduplicate", "promote", "retire"]
				},
				"bullet_count_after": { "type": "integer", "minimum": 0 },
				"bullets_removed": { "type": "integer", "minimum": 0 }
			}
		},
		"assayer.audit.started": {
			"type": "object",
			"additionalProperties": false,
			"required": ["audit_id", "claim_count"],
			"properties": {
				"audit_id": { "type": "string" },
				"claim_count": { "type": "integer", "minimum": 0 },
				"trigger": {
					"type": "string",
					"enum": ["stop", "manual"]
				},
				"command_count": { "type": "integer", "minimum": 0 }
			}
		},
		"assayer.claim.contradicted": {
			"type": "object",
			"additionalProperties": false,
			"required": ["audit_id", "claim", "evidence_command"],
			"properties": {
				"audit_id": { "type": "string" },
				"claim": { "type": "string" },
				"claim_type": {
					"type": "string",
					"enum": [
						"tests_pass",
						"build_succeeds",
						"lint_clean",
						"types_check",
						"command_succeeds",
						"generic"
					]
				},
				"evidence_command": { "type": "string" },
				"result_excerpt": { "type": "string" },
				"exit_code": { "type": "integer" },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		},
		"assayer.claim.unverified": {
			"type": "object",
			"additionalProperties": false,
			"required": ["audit_id", "claim"],
			"properties": {
				"audit_id": { "type": "string" },
				"claim": { "type": "string" },
				"claim_type": {
					"type": "string",
					"enum": [
						"tests_pass",
						"build_succeeds",
						"lint_clean",
						"types_check",
						"command_succeeds",
						"generic"
					]
				},
				"reason": {
					"type": "string",
					"enum": ["no_matching_command", "ambiguous", "no_evidence"]
				}
			}
		},
		"assayer.audit.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"audit_id",
				"claim_count",
				"corroborated",
				"contradicted",
