{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.onlooker.dev/schemas/payload/plugins-memory.json",
	"title": "Memory plugin payloads",
	"description": "Payload schemas for archivist.*, relay.*, scribe.*, oracle.*, prompt_rule.*, cartographer.*, librarian.*, curator.*, historian.*, and memory.* events. Covers the memory plugin layer: archivist (session-scoped extraction), librarian (promotion to typed memory store), curator (memory store audit), historian (episodic retrieval), and the substrate-level memory.recalled event.",
	"$defs": {
		"archivist.extract.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["session_id", "item_count"],
			"properties": {
				"session_id": { "type": "string" },
				"item_count": { "type": "integer", "minimum": 0 },
				"decision_count": { "type": "integer", "minimum": 0 },
				"dead_end_count": { "type": "integer", "minimum": 0 },
				"open_question_count": { "type": "integer", "minimum": 0 },
				"file_count": { "type": "integer", "minimum": 0 },
				"trigger": {
					"type": "string",
					"enum": ["pre_compact", "session_end", "manual"]
				}
			}
		},
		"archivist.compact.started": {
			"type": "object",
			"additionalProperties": false,
			"required": ["project_key", "session_id"],
			"properties": {
				"project_key": { "type": "string" },
				"session_id": { "type": "string" }
			}
		},
		"archivist.compact.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"project_key",
				"session_id",
				"decisions_extracted",
				"dead_ends_extracted",
				"open_questions_extracted",
				"duration_ms"
			],
			"properties": {
				"project_key": { "type": "string" },
				"session_id": { "type": "string" },
				"decisions_extracted": { "type": "integer", "minimum": 0 },
				"dead_ends_extracted": { "type": "integer", "minimum": 0 },
				"open_questions_extracted": { "type": "integer", "minimum": 0 },
				"duration_ms": { "type": "integer", "minimum": 0 }
			}
		},
		"archivist.inject.started": {
			"type": "object",
			"additionalProperties": false,
			"required": ["project_key", "session_id"],
			"properties": {
				"project_key": { "type": "string" },
				"session_id": { "type": "string" }
			}
		},
		"archivist.inject.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"project_key",
				"session_id",
				"items_injected",
				"chars_injected"
			],
			"properties": {
				"project_key": { "type": "string" },
				"session_id": { "type": "string" },
				"items_injected": { "type": "integer", "minimum": 0 },
				"chars_injected": { "type": "integer", "minimum": 0 }
			}
		},
		"relay.handoff.captured": {
			"type": "object",
			"additionalProperties": false,
			"required": ["session_id"],
			"properties": {
				"session_id": { "type": "string" },
				"tasks_in_progress": { "type": "integer", "minimum": 0 },
				"blocking_questions": { "type": "integer", "minimum": 0 },
				"files_in_flight": { "type": "integer", "minimum": 0 }
			}
		},
		"relay.handoff.injected": {
			"type": "object",
			"additionalProperties": false,
			"required": ["source_session_id"],
			"properties": {
				"source_session_id": { "type": "string" },
				"age_ms": { "type": "integer", "minimum": 0 }
			}
		},
		"scribe.capture.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["file_path", "operation"],
			"properties": {
				"file_path": { "type": "string" },
				"operation": { "type": "string", "enum": ["write", "edit"] },
				"intent_summary": { "type": "string" }
			}
		},
		"scribe.distill.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["session_id", "captures_processed", "artifacts_produced"],
			"properties": {
				"session_id": { "type": "string" },
				"captures_processed": { "type": "integer", "minimum": 0 },
				"artifacts_produced": { "type": "integer", "minimum": 0 }
			}
		},
		"oracle.calibration.requested": {
			"type": "object",
			"additionalProperties": false,
			"required": ["trigger"],
			"properties": {
				"trigger": {
					"type": "string",
					"enum": ["user_prompt", "pre_write", "pre_bash"]
				},
				"task_summary": { "type": "string" }
			}
		},
		"oracle.calibration.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["trigger", "confidence_score", "intervened"],
			"properties": {
				"trigger": {
					"type": "string",
					"enum": ["user_prompt", "pre_write", "pre_bash"]
				},
				"confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
				"intervened": { "type": "boolean" },
				"misalignment_detected": { "type": "boolean" }
			}
		},
		"prompt_rule.matched": {
			"type": "object",
			"additionalProperties": false,
			"required": ["rule_id", "match_type", "trigger_source"],
			"properties": {
				"rule_id": { "type": "string" },
				"match_type": {
					"type": "string",
					"enum": ["regex", "vocabulary", "semantic"]
				},
				"trigger_source": {
					"type": "string",
					"enum": ["prompt", "command", "file_path"]
				},
				"rule_name": { "type": "string" }
			}
		},
		"prompt_rule.applied": {
			"type": "object",
			"additionalProperties": false,
			"required": ["rule_id"],
			"properties": {
				"rule_id": { "type": "string" },
				"rule_name": { "type": "string" },
				"guidance_chars": { "type": "integer", "minimum": 0 }
			}
		},
		"cartographer.audit.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["audit_id", "new_finding_count", "total_finding_count"],
			"properties": {
				"audit_id": {
					"type": "string",
					"description": "ULID correlating this event with the cartographer.issue.found events from the same run."
				},
				"new_finding_count": {
					"type": "integer",
					"minimum": 0,
					"description": "Findings not previously seen, i.e. the number of cartographer.issue.found events emitted by this run."
				},
				"total_finding_count": {
					"type": "integer",
					"minimum": 0,
					"description": "All findings the run produced, new and already-known."
				},
				"duration_ms": { "type": "integer", "minimum": 0 },
				"trigger": {
					"type": "string",
					"enum": [
						"session_start_first_run",
						"session_start_interval",
						"post_tool_use",
						"manual"
					]
				}
			}
		},
		"cartographer.issue.found": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"audit_id",
				"finding_hash",
				"finding_type",
				"severity",
				"affected_files"
			],
			"properties": {
				"audit_id": {
					"type": "string",
					"description": "ULID of the audit run that produced this finding."
				},
				"finding_hash": {
					"type": "string",
					"description": "Stable content hash of the finding. Delivery is at-least-once, so consumers MUST deduplicate on this value; a re-emitted finding carries the same hash."
				},
				"finding_type": {
					"type": "string",
					"enum": [
						"contradiction",
						"stale_ref",
						"dead_rule",
						"scope_collision",
						"undocumented_entity"
					]
				},
				"severity": { "type": "string", "enum": ["error", "warning", "info"] },
				"affected_files": {
					"type": "array",
					"minItems": 1,
					"maxItems": 2,
					"items": { "type": "string" },
					"description": "The instruction files the finding implicates. One entry for single-file findings; two when the finding relates a pair (contradiction, scope_collision)."
				},
				"summary": { "type": "string" }
			}
		},
		"memory.recalled": {
			"type": "object",
			"additionalProperties": false,
			"required": ["project_key", "memory_file", "memory_type"],
			"properties": {
				"project_key": { "type": "string" },
				"memory_file": { "type": "string" },
				"memory_type": {
					"type": "string",
					"enum": ["user", "feedback", "project", "reference"]
				},
				"recall_position": { "type": "integer", "minimum": 0 }
			}
		},
		"librarian.scan.started": {
			"type": "object",
			"additionalProperties": false,
			"required": ["trigger"],
			"properties": {
				"trigger": {
					"type": "string",
					"enum": ["session_end", "manual", "bootstrap"]
				},
				"last_scan_at": { "type": "string", "format": "date-time" },
				"artifact_count_in_window": { "type": "integer", "minimum": 0 }
			}
		},
		"librarian.scan.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["outcome", "duration_ms"],
			"properties": {
				"outcome": {
					"type": "string",
					"enum": ["ok", "empty", "skipped"]
				},
				"skip_reason": {
					"type": "string",
					"enum": [
						"archivist_not_present",
						"memory_path_unresolved",
						"disabled"
					]
				},
				"candidates_proposed": { "type": "integer", "minimum": 0 },
				"candidates_dropped": { "type": "integer", "minimum": 0 },
				"duration_ms": { "type": "integer", "minimum": 0 },
				"artifact_count_in_window": { "type": "integer", "minimum": 0 }
			}
		},
		"librarian.candidate.proposed": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"proposal_id",
				"memory_type",
				"classifier_confidence",
				"conflict_state"
			],
			"properties": {
				"proposal_id": { "type": "string" },
				"memory_type": {
					"type": "string",
					"enum": ["user", "feedback", "project", "reference"]
				},
				"classifier_confidence": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"conflict_state": {
					"type": "string",
					"enum": ["none", "duplicate", "merge_candidate", "conflict_candidate"]
				},
				"source_artifact_ids": {
					"type": "array",
					"items": { "type": "string" }
				}
			}
		},
		"librarian.candidate.dropped": {
			"type": "object",
			"additionalProperties": false,
			"required": ["reason"],
			"properties": {
				"reason": {
					"type": "string",
					"enum": [
						"duplicate",
						"low_confidence",
						"classified_null",
						"filter_marker_missing",
						"filter_repetition_missing",
						"detail_too_short"
					]
				},
				"source_artifact_id": { "type": "string" }
			}
		},
		"librarian.proposal.accepted": {
			"type": "object",
			"additionalProperties": false,
			"required": ["proposal_id", "final_filename", "accepted_via"],
			"properties": {
				"proposal_id": { "type": "string" },
				"final_filename": { "type": "string" },
				"accepted_via": { "type": "string", "enum": ["manual", "auto"] }
			}
		},
		"librarian.proposal.rejected": {
			"type": "object",
			"additionalProperties": false,
			"required": ["proposal_id"],
			"properties": {
				"proposal_id": { "type": "string" },
				"reason": { "type": "string" }
			}
		},
		"librarian.proposal.merged": {
			"type": "object",
			"additionalProperties": false,
			"required": ["proposal_id", "merged_into_filename"],
			"properties": {
				"proposal_id": { "type": "string" },
				"merged_into_filename": { "type": "string" }
			}
		},
		"librarian.proposal.superseded": {
			"type": "object",
			"additionalProperties": false,
			"required": ["proposal_id", "superseded_filename"],
			"properties": {
				"proposal_id": { "type": "string" },
				"superseded_filename": { "type": "string" }
			}
		},
		"librarian.tombstone.created": {
			"type": "object",
			"additionalProperties": false,
			"required": ["body_hash"],
			"properties": {
				"body_hash": { "type": "string" },
				"original_filename": { "type": "string" }
			}
		},
		"curator.scan.started": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode"],
			"properties": {
				"mode": { "type": "string", "enum": ["cheap", "llm", "manual"] }
			}
		},
		"curator.scan.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"mode",
				"outcome",
				"findings_new",
				"findings_resolved",
				"duration_ms"
			],
			"properties": {
				"mode": { "type": "string", "enum": ["cheap", "llm", "manual"] },
				"outcome": { "type": "string", "enum": ["ok", "skipped"] },
				"skip_reason": {
					"type": "string",
					"enum": [
						"over_budget",
						"llm_interval_not_elapsed",
						"disabled",
						"recent_session_skip"
					]
				},
				"findings_new": { "type": "integer", "minimum": 0 },
				"findings_resolved": { "type": "integer", "minimum": 0 },
				"duration_ms": { "type": "integer", "minimum": 0 },
				"pairs_evaluated": { "type": "integer", "minimum": 0 }
			}
		},
		"curator.finding.date_decayed": {
			"type": "object",
			"additionalProperties": false,
			"required": ["finding_id", "memory_file", "matched_phrase", "days_past"],
			"properties": {
				"finding_id": { "type": "string" },
				"memory_file": { "type": "string" },
				"matched_phrase": { "type": "string" },
				"days_past": { "type": "integer", "minimum": 0 }
			}
		},
		"curator.finding.path_broken": {
			"type": "object",
			"additionalProperties": false,
			"required": ["finding_id", "memory_file", "broken_path"],
			"properties": {
				"finding_id": { "type": "string" },
				"memory_file": { "type": "string" },
				"broken_path": { "type": "string" }
			}
		},
		"curator.finding.symbol_missing": {
			"type": "object",
			"additionalProperties": false,
			"required": ["finding_id", "memory_file", "symbol"],
			"properties": {
				"finding_id": { "type": "string" },
				"memory_file": { "type": "string" },
				"symbol": { "type": "string" }
			}
		},
		"curator.finding.url_unchecked": {
			"type": "object",
			"additionalProperties": false,
			"required": ["finding_id", "memory_file", "url_host"],
			"properties": {
				"finding_id": { "type": "string" },
				"memory_file": { "type": "string" },
				"url_host": { "type": "string" }
			}
		},
		"curator.finding.unused_low_signal": {
			"type": "object",
			"additionalProperties": false,
			"required": ["finding_id", "memory_file", "window_days"],
			"properties": {
				"finding_id": { "type": "string" },
				"memory_file": { "type": "string" },
				"window_days": { "type": "integer", "minimum": 1 }
			}
		},
		"curator.finding.contradiction": {
			"type": "object",
			"additionalProperties": false,
			"required": ["finding_id", "memory_a", "memory_b", "rationale"],
			"properties": {
				"finding_id": { "type": "string" },
				"memory_a": { "type": "string" },
				"memory_b": { "type": "string" },
				"rationale": { "type": "string" }
			}
		},
		"curator.finding.redundant_pair": {
			"type": "object",
			"additionalProperties": false,
			"required": ["finding_id", "memory_a", "memory_b", "rationale"],
			"properties": {
				"finding_id": { "type": "string" },
				"memory_a": { "type": "string" },
				"memory_b": { "type": "string" },
				"rationale": { "type": "string" }
			}
		},
		"curator.finding.broken_index": {
			"type": "object",
			"additionalProperties": false,
			"required": ["finding_id", "referenced_file"],
			"properties": {
				"finding_id": { "type": "string" },
				"referenced_file": { "type": "string" }
			}
		},
		"curator.finding.orphaned_memory": {
			"type": "object",
			"additionalProperties": false,
			"required": ["finding_id", "memory_file"],
			"properties": {
				"finding_id": { "type": "string" },
				"memory_file": { "type": "string" }
			}
		},
		"curator.finding.acknowledged": {
			"type": "object",
			"additionalProperties": false,
			"required": ["finding_id"],
			"properties": {
				"finding_id": { "type": "string" }
			}
		},
		"curator.finding.resolved": {
			"type": "object",
			"additionalProperties": false,
			"required": ["finding_id", "action"],
			"properties": {
				"finding_id": { "type": "string" },
				"action": {
					"type": "string",
					"enum": ["prune", "edit", "reclassify", "defer"]
				}
			}
		},
		"historian.indexing.started": {
			"type": "object",
			"additionalProperties": false,
			"required": ["session_id", "transcript_chars"],
			"properties": {
				"session_id": { "type": "string" },
				"transcript_chars": { "type": "integer", "minimum": 0 }
			}
		},
		"historian.indexing.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["outcome", "duration_ms"],
			"properties": {
				"outcome": {
					"type": "string",
					"enum": ["ok", "skipped"]
				},
				"skip_reason": {
					"type": "string",
					"enum": [
						"too_short",
						"embedder_unavailable",
						"disabled",
						"transcript_unavailable"
					]
				},
				"chunks_indexed": { "type": "integer", "minimum": 0 },
				"chunks_dropped": { "type": "integer", "minimum": 0 },
				"duration_ms": { "type": "integer", "minimum": 0 }
			}
		},
		"historian.chunk.sanitized": {
			"type": "object",
			"additionalProperties": false,
			"required": ["chunk_id", "redaction_count"],
			"properties": {
				"chunk_id": { "type": "string" },
				"redaction_count": { "type": "integer", "minimum": 1 }
			}
		},
		"historian.chunk.dropped": {
			"type": "object",
			"additionalProperties": false,
			"required": ["reason"],
			"properties": {
				"reason": {
					"type": "string",
					"enum": ["skip_marker", "never_index_path"]
				}
			}
		},
		"historian.embedder.unavailable": {
			"type": "object",
			"additionalProperties": false,
			"required": ["backend"],
			"properties": {
				"backend": {
					"type": "string",
					"enum": ["ollama", "fastembed", "remote"]
				},
				"error_summary": { "type": "string" }
			}
		},
		"historian.retrieval.started": {
			"type": "object",
			"additionalProperties": false,
			"required": ["prompt_chars"],
			"properties": {
				"prompt_chars": { "type": "integer", "minimum": 0 }
			}
		},
		"historian.retrieval.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["outcome"],
			"properties": {
				"outcome": {
					"type": "string",
					"enum": ["surfaced", "empty", "skipped"]
				},
				"skip_reason": {
					"type": "string",
					"enum": [
						"cooldown",
						"budget",
						"short_prompt",
						"disabled",
						"embedder_unavailable"
					]
				},
				"top_similarity": { "type": "number", "minimum": 0, "maximum": 1 },
				"candidates_above_floor": { "type": "integer", "minimum": 0 },
				"duration_ms": { "type": "integer", "minimum": 0 }
			}
		},
		"historian.retrieval.surfaced": {
			"type": "object",
			"additionalProperties": false,
			"required": ["chunk_id", "similarity", "age_days"],
			"properties": {
				"chunk_id": { "type": "string" },
				"similarity": { "type": "number", "minimum": 0, "maximum": 1 },
				"age_days": { "type": "integer", "minimum": 0 },
				"source_session_id": { "type": "string" }
			}
		},
		"historian.prune.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["chunks_pruned", "chunks_remaining"],
			"properties": {
				"chunks_pruned": { "type": "integer", "minimum": 0 },
				"chunks_remaining": { "type": "integer", "minimum": 0 }
			}
		},
		"historian.purge.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["scope", "chunks_purged"],
			"properties": {
				"scope": {
					"type": "string",
					"enum": ["session", "date_range", "all"]
				},
				"chunks_purged": { "type": "integer", "minimum": 0 }
			}
		},
		"historian.config.warning": {
			"type": "object",
			"additionalProperties": false,
			"required": ["warning"],
			"properties": {
				"warning": {
					"type": "string",
					"enum": [
						"remote_egress_not_allowed",
						"model_mismatch",
						"embedder_path_changed"
					]
				},
				"detail": { "type": "string" }
			}
		}
	}
}
