{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.onlooker.dev/schemas/payload/tool.json",
	"title": "Tool payloads",
	"description": "Payload schemas for the tool.* event family.",
	"$defs": {
		"tool.file.read": {
			"type": "object",
			"additionalProperties": false,
			"required": ["path", "read_mode"],
			"properties": {
				"path": { "type": "string" },
				"read_mode": {
					"type": "string",
					"enum": ["full", "partial"],
					"description": "Whether the Read tool used line offset/limit (partial) or read the whole file (full)."
				},
				"offset": {
					"type": "integer",
					"minimum": 0,
					"description": "Line offset from tool_input when present (partial reads)."
				},
				"limit": {
					"type": "integer",
					"minimum": 1,
					"description": "Line limit from tool_input when present (partial reads)."
				},
				"lines_read": {
					"type": "integer",
					"minimum": 0,
					"description": "Lines returned in tool_response content."
				},
				"file_size_bytes": {
					"type": "integer",
					"minimum": 0,
					"description": "Bytes of content returned in tool_response."
				},
				"file_bytes_on_disk": {
					"type": "integer",
					"minimum": 0,
					"description": "File size on disk when path is readable at hook time."
				},
				"file_lines_on_disk": {
					"type": "integer",
					"minimum": 0,
					"description": "Total line count on disk when measured (omitted for very large files)."
				},
				"large_file_full_read": {
					"type": "boolean",
					"description": "True when read_mode is full and on-disk file exceeds the large-file threshold."
				}
			}
		},
		"tool.file.write": {
			"type": "object",
			"additionalProperties": false,
			"required": ["path", "operation"],
			"properties": {
				"path": { "type": "string" },
				"operation": { "type": "string", "enum": ["create", "overwrite"] },
				"bytes_written": { "type": "integer", "minimum": 0 },
				"lines_written": { "type": "integer", "minimum": 0 }
			}
		},
		"tool.file.edit": {
			"type": "object",
			"additionalProperties": false,
			"required": ["path"],
			"properties": {
				"path": { "type": "string" },
				"lines_changed": { "type": "integer", "minimum": 0 }
			}
		},
		"tool.shell.exec": {
			"type": "object",
			"additionalProperties": false,
			"required": ["command"],
			"properties": {
				"command": { "type": "string" },
				"exit_code": { "type": "integer" },
				"duration_ms": { "type": "integer", "minimum": 0 },
				"working_directory": { "type": "string" },
				"blocked": { "type": "boolean" }
			}
		},
		"tool.web.fetch": {
			"type": "object",
			"additionalProperties": false,
			"required": ["url"],
			"properties": {
				"url": { "type": "string", "format": "uri" },
				"status_code": { "type": "integer", "minimum": 100, "maximum": 599 },
				"response_bytes": { "type": "integer", "minimum": 0 },
				"blocked": { "type": "boolean" }
			}
		},
		"tool.agent.spawn": {
			"type": "object",
			"additionalProperties": false,
			"required": ["subagent_id"],
			"properties": {
				"subagent_id": { "type": "string" },
				"agent_name": { "type": "string" },
				"task_summary": { "type": "string" },
				"blocked": { "type": "boolean" }
			}
		},
		"tool.agent.complete": {
			"type": "object",
			"additionalProperties": false,
			"required": ["subagent_id", "success"],
			"properties": {
				"subagent_id": { "type": "string" },
				"success": { "type": "boolean" },
				"agent_name": { "type": "string" },
				"duration_ms": { "type": "integer", "minimum": 0 },
				"cost_usd": { "type": "number", "minimum": 0 },
				"output_summary": { "type": "string" }
			}
		}
	}
}
